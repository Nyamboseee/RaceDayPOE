@model EventFormViewModel
@{
    var editing = Model.Id.HasValue;
    ViewData["Title"] = editing ? "Edit event" : "New event";
}
<div class="page-head">
    <h1 class="rd-heading">@(editing ? "Edit event" : "Create an event")</h1>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card form-card">
            <div class="card-body p-4">
                <form method="post" enctype="multipart/form-data" novalidate
                      asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.Id">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="EventName" class="form-label"></label>
                        <input asp-for="EventName" class="form-control" />
                        <span asp-validation-for="EventName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="EventDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Distance" class="form-label"></label>
                            <input asp-for="Distance" class="form-control" type="number" step="0.1" min="0.1" />
                            <span asp-validation-for="Distance" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" class="form-select">
                                <option value="Run">Run</option>
                                <option value="Walk">Walk</option>
                                <option value="Cycle">Cycle</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Banner" class="form-label"></label>
                        @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ExistingBannerUrl" class="banner-preview" alt="Current banner" />
                            </div>
                        }
                        <input asp-for="Banner" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" />
                        <div class="form-text">Optional. JPG, PNG or WEBP, up to 5 MB.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-rd">@(editing ? "Save changes" : "Create event")</button>
                        <a class="btn btn-outline-dark" asp-action="Events">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
