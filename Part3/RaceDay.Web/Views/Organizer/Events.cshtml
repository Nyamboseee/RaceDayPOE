@model List<EventDto>
@{
    ViewData["Title"] = "My Events";
}
<div class="d-flex flex-wrap justify-content-between align-items-end page-head">
    <div>
        <h1 class="rd-heading">My events</h1>
        <p class="text-muted mb-0">Create events, then add categories, confirm enrolments and capture results.</p>
    </div>
    <a class="btn btn-rd" asp-action="CreateEvent">New event</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">No events yet</h2>
        <p class="text-muted">Create your first event to get started.</p>
        <a class="btn btn-rd" asp-action="CreateEvent">Create event</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card event-card h-100">
                    @if (!string.IsNullOrEmpty(e.BannerUrl))
                    {
                        <img src="@e.BannerUrl" class="event-card-img" alt="Banner for @e.Name" />
                    }
                    else
                    {
                        <div class="event-card-img banner-placeholder type-@e.EventType.ToLower()"><span>@e.EventType</span></div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="event-date">@e.Date.ToString("ddd, d MMM yyyy") &middot; @e.Date.ToString("HH:mm")</div>
                        <h2 class="h5 card-title">@e.Name</h2>
                        <p class="text-muted mb-2">@e.Location</p>
                        <div class="mb-3">
                            <span class="chip">@e.EventType</span>
                            <span class="chip">@e.Distance.ToString("0.##") km</span>
                            <span class="chip">@e.CategoryCount categories</span>
                            <span class="chip">@e.EnrollmentCount enrolled</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <a class="btn btn-outline-dark btn-sm" asp-action="Categories" asp-route-eventId="@e.Id">Categories</a>
                            <a class="btn btn-outline-dark btn-sm" asp-action="Enrolments" asp-route-eventId="@e.Id">Enrolments</a>
                            <a class="btn btn-outline-dark btn-sm" asp-action="Results" asp-route-eventId="@e.Id">Results</a>
                            <a class="btn btn-rd btn-sm" asp-action="EditEvent" asp-route-id="@e.Id">Edit</a>
                            <form asp-action="DeleteEvent" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <input type="hidden" name="id" value="@e.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
