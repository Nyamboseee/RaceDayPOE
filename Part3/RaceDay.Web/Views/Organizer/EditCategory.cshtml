@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}
<div class="mb-3">
    <a asp-action="Categories" asp-route-eventId="@Model.EventId" class="text-muted small">&larr; Categories</a>
</div>
<div class="page-head"><h1 class="rd-heading">Edit category</h1></div>

<div class="row">
    <div class="col-lg-6">
        <div class="card form-card">
            <div class="card-body p-4">
                <form asp-action="EditCategory" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label"></label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" class="form-control" type="number" step="0.1" min="0.1" />
                        <span asp-validation-for="Distance" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="MinAge" class="form-label"></label>
                            <input asp-for="MinAge" class="form-control" type="number" min="0" max="120" />
                            <span asp-validation-for="MinAge" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="MaxAge" class="form-label"></label>
                            <input asp-for="MaxAge" class="form-control" type="number" min="0" max="120" />
                            <span asp-validation-for="MaxAge" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-rd">Save changes</button>
                        <a class="btn btn-outline-dark" asp-action="Categories" asp-route-eventId="@Model.EventId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
