@model EventFilterViewModel
@{
    ViewData["Title"] = "Events";
}
<div class="page-head">
    <h1 class="rd-heading">Find your next race</h1>
    <p class="text-muted mb-0">Upcoming runs, walks and rides across South Africa.</p>
</div>

<form method="get" asp-action="Index" class="filter-bar card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Event name or place" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="type">Type</label>
            <select class="form-select" id="type" name="type">
                <option value="">All types</option>
                <option value="Run" selected="@(Model.Type == "Run")">Run</option>
                <option value="Walk" selected="@(Model.Type == "Walk")">Walk</option>
                <option value="Cycle" selected="@(Model.Type == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="maxDistance">Up to (km)</label>
            <input class="form-control" id="maxDistance" name="maxDistance" type="number" min="0" step="0.1"
                   value="@Model.MaxDistance" />
        </div>
        <div class="col-md-2">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="showPast" name="showPast" value="true"
                       checked="@Model.ShowPast" />
                <label class="form-check-label" for="showPast">Include past</label>
            </div>
        </div>
        <div class="col-md-1 d-grid">
            <button class="btn btn-rd" type="submit">Filter</button>
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">No events match</h2>
        <p class="text-muted mb-0">Try clearing the filters, or check back soon.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
}
