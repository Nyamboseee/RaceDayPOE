@model List<MyEnrollmentDto>
@{
    ViewData["Title"] = "My Enrolments";
}
<div class="page-head">
    <h1 class="rd-heading">My enrolments</h1>
    <p class="text-muted mb-0">Every race you have entered, with its status.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">You have not entered any events yet</h2>
        <p class="text-muted">Find a race and pick a category to enrol.</p>
        <a class="btn btn-rd" asp-controller="Events" asp-action="Index">Browse events</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Bib</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                        <td>@e.EventDate.ToString("d MMM yyyy")</td>
                        <td>@e.CategoryName</td>
                        <td><code>@e.BibNumber</code></td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            @if (e.EventDate >= DateTime.Today)
                            {
                                <form asp-action="Cancel" method="post" class="d-inline"
                                      onsubmit="return confirm('Cancel this enrolment?');">
                                    <input type="hidden" name="id" value="@e.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
