@model List<MyResultDto>
@{
    ViewData["Title"] = "My Results";

    string Ordinal(int n)
    {
        var tens = n % 100;
        if (tens is >= 11 and <= 13) return n + "th";
        return (n % 10) switch { 1 => n + "st", 2 => n + "nd", 3 => n + "rd", _ => n + "th" };
    }
}
<div class="page-head">
    <h1 class="rd-heading">My race history</h1>
    <p class="text-muted mb-0">Results the organisers have captured for the events you entered.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">No results yet</h2>
        <p class="text-muted mb-0">Your results appear here once an organiser captures them after the event.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.EventName</td>
                        <td>@r.EventDate.ToString("d MMM yyyy")</td>
                        <td>@r.CategoryName</td>
                        <td>
                            @if (r.Status == "Finished" && r.FinishTime.HasValue)
                            {
                                <strong>@r.FinishTime.Value.ToString(@"hh\:mm\:ss")</strong>
                            }
                            else
                            {
                                <partial name="_StatusBadge" model="r.Status" />
                            }
                        </td>
                        <td>
                            @if (r.Status == "Finished" && r.Position.HasValue)
                            {
                                <span class="position">@Ordinal(r.Position.Value)</span>
                                <span class="text-muted">of @r.TotalFinishers finishers</span>
                            }
                            else
                            {
                                <span class="text-muted">&ndash;</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
