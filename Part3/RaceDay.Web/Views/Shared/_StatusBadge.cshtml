@model string
@{
    var css = Model switch
    {
        "Confirmed" => "status-confirmed",
        "Pending" => "status-pending",
        "Finished" => "status-confirmed",
        "DNF" => "status-dnf",
        "DNS" => "status-dnf",
        _ => "status-pending"
    };
}
<span class="status-badge @css">@Model</span>
