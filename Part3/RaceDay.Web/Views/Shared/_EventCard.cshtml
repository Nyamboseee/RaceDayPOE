@model EventDto
<div class="card event-card h-100">
    @if (!string.IsNullOrEmpty(Model.BannerUrl))
    {
        <img src="@Model.BannerUrl" class="event-card-img" alt="Banner for @Model.Name" />
    }
    else
    {
        <div class="event-card-img banner-placeholder type-@Model.EventType.ToLower()"><span>@Model.EventType</span></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="event-date">@Model.Date.ToString("ddd, d MMM yyyy") &middot; @Model.Date.ToString("HH:mm")</div>
        <h2 class="h5 card-title">@Model.Name</h2>
        <p class="text-muted mb-2">@Model.Location</p>
        <div class="mb-3">
            <span class="chip">@Model.EventType</span>
            <span class="chip">@Model.Distance.ToString("0.##") km</span>
        </div>
        <a class="btn btn-rd mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">View event</a>
    </div>
</div>
